    "cook": "node bin/cook.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
