{
  "name": "cook-cf-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Runner",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-4",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RUNNER", "class_name": "Runner" }]
  },
  "exports": {
    "Runner": { "type": "durable-object", "storage": "sqlite" }
  }
}
